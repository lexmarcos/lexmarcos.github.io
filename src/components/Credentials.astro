---
import { Icon } from 'astro-icon/components';
import { clients, education, work } from '../data/profile';
---

<footer class="credentials">
  <section class="group" aria-labelledby="clients-title">
    <h2 id="clients-title" class="label label--tight">Já desenvolvi para</h2>
    <ul class="clients">
      {
        clients.map((client) => (
          <li style={`--ratio: ${client.ratio}`}>
            <Icon name={client.icon} role="img" aria-label={client.name} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="group" aria-labelledby="work-title">
    <h2 id="work-title" class="label label--tight">Hoje trabalho no</h2>
    <ul class="value">
      {work.map((place) => <li>{place}</li>)}
    </ul>
  </section>

  <section class="group" aria-labelledby="edu-title">
    <h2 id="edu-title" class="label label--tight">Formação</h2>
    <p class="value">
      {education.degree}, <abbr title={education.schoolFull}>{education.school}</abbr>
    </p>
  </section>
</footer>

<style>
  .credentials {
    display: grid;
    gap: var(--s-6);
    padding-top: var(--s-6);
    border-top: var(--line) solid var(--ink);
  }

  .clients {
    display: flex;
    align-items: center;
    gap: var(--s-7);
    min-height: 2rem;
  }

  .clients svg {
    height: 1.375rem;
    width: calc(1.375rem * var(--ratio));
  }

  .value {
    font-size: var(--t-md);
    font-weight: var(--w-strong);
    font-stretch: 88%;
    line-height: 1.3;
  }

  abbr {
    text-decoration: none;
  }

  @media (min-width: 40rem) {
    .credentials {
      grid-template-columns: repeat(3, auto);
      justify-content: space-between;
    }
  }

  /* No desktop as colunas seguem a grade da página */
  @media (min-width: 1024px) and (orientation: landscape) {
    .credentials {
      grid-template-columns: var(--columns);
      column-gap: var(--column-gap);
      justify-content: stretch;
    }
  }
</style>
